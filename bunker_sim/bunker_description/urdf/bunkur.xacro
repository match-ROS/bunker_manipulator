  <xacro:arg name="ur_mount_rpy" default="0 0 0"/>
  <xacro:arg name="ur_initial_shoulder_pan_joint" default="0.1745329252"/>
  <xacro:arg name="ur_initial_shoulder_lift_joint" default="-1.57"/>
