  <!-- /////////////////////////////////   gazebo color   ////////////////////////////////////// -->

  <!-- Minimal ros2_control configuration for Gazebo (gz/ignition)
       This exposes velocity command & state interfaces for the four drive joints
       so gz_ros2_control / ign_ros2_control can attach a hardware bridge. -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="wheel1_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel2_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel3_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel4_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- New joints for additional track wheels -->
    <joint name="wheel1.2_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel3.1_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel3.2_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel4.1_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel4.2_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel2.2_joint">
      <command_interface name="velocity">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- Passive track wheels need state interfaces so robot_state_publisher can publish TF. -->
    <joint name="wheel1.1_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel1.3_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel2.1_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel2.3_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel3.3_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="wheel4.3_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo Sim integration: load gz/ign ros2_control bridge plugin -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- Ensure controller_manager is created in the root namespace -->
      <ros>
        <namespace>/</namespace>
      </ros>
  <!-- Controller configs/types (loaded as plugin params file) -->
  <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="gz-sim-tracked-vehicle-system"
      name="gz::sim::systems::TrackedVehicle">
      <left_track>
        <link>left_track</link>
      </left_track>
      <right_track>
        <link>right_track</link>
      </right_track>
      <tracks_separation>0.699</tracks_separation>
      <tracks_height>0.064</tracks_height>
      <steering_efficiency>1.0</steering_efficiency>
      <topic>$(arg tracked_cmd_topic)</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin
      filename="gz-sim-track-controller-system"
      name="gz::sim::systems::TrackController">
      <link>left_track</link>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
    </plugin>
    <plugin
      filename="gz-sim-track-controller-system"
      name="gz::sim::systems::TrackController">
      <link>right_track</link>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
    </plugin>
  </gazebo>

  <gazebo reference="left_track">
    <mu1>0.7</mu1>
    <mu2>150.0</mu2>
    <fdir1>0 1 0</fdir1>
    <maxContacts>20</maxContacts>
  </gazebo>
  <gazebo reference="right_track">
    <mu1>0.7</mu1>
    <mu2>150.0</mu2>
    <fdir1>0 1 0</fdir1>
    <maxContacts>20</maxContacts>
  </gazebo>

  <!-- The native track links provide traction. Wheel contacts are visual/support
       geometry only and must not oppose lateral skid during an in-place turn. -->
  <gazebo reference="wheel1_Link">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="wheel2_Link">
